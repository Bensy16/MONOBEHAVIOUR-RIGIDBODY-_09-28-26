using UnityEngine;
using System; // Required for Math.Round

public class GridMovement : MonoBehaviour {
    public float tileSize = 1.0f; // size of one grid cell
    public float moveSpeed = 10f; // how fast your character glides between tiles

    private Vector3 targetPosition; // Fixed typo (positions -> position)
    private bool isMoving = false;

    void Start()
    {
        // Snap starting position to the grid so everything lines up
        targetPosition = SnapToGrid(transform.position);
        transform.position = targetPosition;
    }

    void Update()
    {
        if (!isMoving)
        {
            HandleInput(); // Fixed typo (HanldeInput -> HandleInput)
        }
        else
        {
            // Smoothly move towards the target
            transform.position = Vector3.MoveTowards(transform.position, targetPosition, moveSpeed * Time.deltaTime); // Fixed typos
            
            
            if (Vector3.Distance(transform.position, targetPosition) < 0.001f) 
            {
                transform.position = targetPosition;
                isMoving = false;
            }
        }
    }

    void HandleInput()
    {
        Vector3 direction = Vector3.zero;

        if (Input.GetKeyDown(KeyCode.W)) direction = Vector3.up;
        else if (Input.GetKeyDown(KeyCode.S)) direction = Vector3.down;
        else if (Input.GetKeyDown(KeyCode.A)) direction = Vector3.left;
        else if (Input.GetKeyDown(KeyCode.D)) direction = Vector3.right;

        if (direction != Vector3.zero)
        {
            targetPosition = transform.position + direction * tileSize;
            isMoving = true;
        }
    }

    Vector3 SnapToGrid(Vector3 pos)
    {
        return new Vector3(
            (float)Math.Round(pos.x / tileSize) * tileSize,
            (float)Math.Round(pos.y / tileSize) * tileSize,
            pos.z
        );
    }
}
// Free (Vector Base) Movement
// Attach this a character GameObject. Good for top-down action games, platformers( horizontal axis), twin-stick shooters. Movement is continous, not tile locked.

using UnityEngine;
public class FreeMovement : MonoBehaviour
{
    public float moveSpeed = 5f;

    void Update()
    {
     //GetAxis gives smooth values between -1 and 1 (supports keyboard AND controller)
     float horizontal = Input.GetAxis("Horizontal"); // A/D or Left/Right Arrows
     float vertical = Input.GetAxis("Vertical"); // W/S or Left and Up/Down Arrows

     Vector3 direction = new Vector3(horizontal,vertical, 0f);
    // Normalize so diagonal movement isn't faster than straight movement
     if (direction.magnitude >1f)
     {
         direction.Normalize();
     }
         transform.position += direction *moveSpeed * Time.deltaTime;
     }
}
